{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Reconstructed from the allenwang0.github.io plan (card.json contract, schema_version 1). Replace with that repo's scripts/card.schema.json once it exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repo", "sha", "generated_at", "command", "data_note", "metric", "takeaway", "chart"],
  "properties": {
    "schema_version": {"const": 1},
    "repo": {"type": "string"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "command": {"type": "string"},
    "data_note": {"type": "string"},
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "value", "unit", "higher_is_better"],
      "properties": {
        "label": {"type": "string"}, "value": {"type": "number"},
        "unit": {"type": "string"}, "higher_is_better": {"type": "boolean"}
      }
    },
    "takeaway": {"type": "string", "maxLength": 140},
    "chart": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "x_label", "x_unit", "x_scale", "y_label", "y_unit", "y_scale", "series"],
          "properties": {
            "type": {"const": "line"},
            "x_label": {"type": "string"}, "x_unit": {"type": "string"},
            "x_scale": {"enum": ["linear", "log", "time"]},
            "y_label": {"type": "string"}, "y_unit": {"type": "string"},
            "y_scale": {"enum": ["linear", "log"]},
            "series": {
              "type": "array", "minItems": 1, "maxItems": 4,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "style", "points"],
                "properties": {
                  "name": {"type": "string"},
                  "style": {"enum": ["solid", "dashed", "dots"]},
                  "points": {"type": "array", "maxItems": 500,
                             "items": {"type": "array", "minItems": 2, "maxItems": 2}}
                }
              }
            }
          }
        }
      ]
    }
  }
}
